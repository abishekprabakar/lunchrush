{
  "name": "lunchrush",
  "private": true,
  "description": "A learning project: offline-first restaurant orders that sync peer-to-peer with hand-written delta-state CRDTs. Inspired by Ditto; not a Ditto product.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "check": "eslint . && tsc -p . && vitest run",
    "bench": "tsx packages/sim/src/bench.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
